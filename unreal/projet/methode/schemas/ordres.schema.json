{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "ordres",
 "title": "Liste d'ordres pour la boîte à outils",
 "description": "Pour retoucher un niveau déjà construit sans le redessiner. Le modèle écrit la liste (phase LM Studio), l'outil l'applique dans Unreal (phase Unreal) et rend un rapport ligne par ligne : fait / refusé + raison. Coordonnées en cases de la grille (x vers la droite, y vers le bas). OUTIL PAS ENCORE ÉCRIT : format de référence.",
 "type": "object",
 "required": ["niveau", "but", "ordres"],
 "additionalProperties": false,
 "properties": {
  "niveau": {"type": "integer", "minimum": 1},
  "but": {"type": "string", "maxLength": 300, "description": "ce que la liste doit corriger ou ajouter"},
  "ordres": {
   "type": "array", "minItems": 1, "maxItems": 40,
   "items": {
    "oneOf": [
     {"type": "object", "required": ["faire", "car", "x", "y"], "additionalProperties": false,
      "properties": {"faire": {"const": "poser"}, "car": {"type": "string", "minLength": 1, "maxLength": 1, "description": "monstre ou objet de la légende"}, "x": {"type": "integer"}, "y": {"type": "integer"}}},
     {"type": "object", "required": ["faire", "x", "y"], "additionalProperties": false,
      "properties": {"faire": {"const": "retirer"}, "x": {"type": "integer"}, "y": {"type": "integer"}}},
     {"type": "object", "required": ["faire", "x", "y", "vers_x", "vers_y"], "additionalProperties": false,
      "properties": {"faire": {"const": "deplacer"}, "x": {"type": "integer"}, "y": {"type": "integer"}, "vers_x": {"type": "integer"}, "vers_y": {"type": "integer"}}},
     {"type": "object", "required": ["faire", "x", "y", "car"], "additionalProperties": false,
      "properties": {"faire": {"const": "changer_case"}, "x": {"type": "integer"}, "y": {"type": "integer"}, "car": {"type": "string", "minLength": 1, "maxLength": 1, "description": "nouveau caractère (mur, sol, porte…)"}}},
     {"type": "object", "required": ["faire", "x", "y"], "additionalProperties": false,
      "properties": {"faire": {"const": "lampe"}, "x": {"type": "integer"}, "y": {"type": "integer"}, "intensite": {"type": "number", "default": 1}}},
     {"type": "object", "required": ["faire", "zone"], "additionalProperties": false,
      "properties": {"faire": {"const": "regarder"}, "zone": {"type": "string", "description": "id de zone du plan ou « x,y »"}}},
     {"type": "object", "required": ["faire"], "additionalProperties": false,
      "properties": {"faire": {"const": "essayer"}, "test": {"enum": ["atteignable", "monstres", "objets", "secrets", "sortie", "tout"], "default": "tout"}}}
    ]
   }
  }
 }
}
